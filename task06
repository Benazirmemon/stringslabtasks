#include<stdio.h>
int multiply(int no1, int no2){
  if(no2==0){
    return 0;
  }
  int result=no1+multiply(no1,no2-1);
  return result;
  
}
int main(){
  int no1;
  int no2;
  int result;
  printf("enter no 1");
  scanf("%d",&no1);
  printf("enter no 2");
  scanf("%d",&no2);
  result=multiply(no1,no2);
  printf("product of %d and %d is %d\n",no1,no2,result);
  
}
